<Project>

  <!--
    Central Package Management. SHARED FILE - read-only for feature agents.

    Every version is pinned exactly with NuGet bracket notation: [10.0.12] means
    that version and no other. A bare "10.0.12" is a *minimum* to NuGet, not an
    exact pin, which is why it is not used here.

    Projects reference packages without a Version attribute; the version comes
    from this file. Do not add a package here. See AGENTS.md.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Application">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="[10.0.12]" />
    <PackageVersion Include="Scalar.AspNetCore" Version="[2.17.3]" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="[10.0.12]" />
    <PackageVersion Include="xunit.v3" Version="[4.0.0]" />
  </ItemGroup>

</Project>
